{
  "name": "school-supplies-eshop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev-local": "vite",
    "dev": "concurrently --kill-others-on-fail \"npm run firebase-dev\" \"npm run dev-local\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "format": "prettier --write src/",
    "firebase-dev": "firebase emulators:start --project school-supplies-store-3834d",
    "preseed-production": "firebase deploy --only firestore:rules --config firestore.seed.rules.json",
    "seed-production": "node src/db/seeds/seed-firestore.js",
    "postseed-production": "firebase deploy --only firestore:rules --config firestore.rules.json",
    "kill-ports": "npx kill-port 8080 9099 4000 5173 8888"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.13.0",
    "@stripe/react-stripe-js": "^3.1.1",
    "@stripe/stripe-js": "^5.5.0",
    "axios": "^1.20.0",
    "dotenv": "^16.4.7",
    "firebase": "^12.19.0",
    "nodemailer": "^10.0.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4",
    "react-slick": "^0.31.0",
    "react-stripe-checkout": "^2.6.3",
    "redux-persist": "^6.0.0",
    "stripe": "^22.6.2",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@eslint/js": "^9.20.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-styled-components": "^2.3.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.20.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^15.14.0",
    "prettier": "^3.9.9",
    "vite": "^8.3.1"
  }
}
